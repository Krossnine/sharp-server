{
  "name": "@sharp-server/image-api-playground",
  "version": "0.1.0",
  "private": true,
  "files": [
    "/dist"
  ],
  "dependencies": {
    "@sharp-server/image-api-client": "^0.1.0",
    "bootstrap": "^5.2.3",
    "express": "^4.18.2",
    "next": "13.0.6",
    "react": "18.2.0",
    "react-bootstrap": "^2.6.0",
    "react-bootstrap-icons": "^1.10.2",
    "react-color": "^2.19.3",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.40.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.14",
    "@types/node": "^16.18.12",
    "@types/react": "^18.0.27",
    "@types/react-color": "^3.0.6",
    "@types/react-dom": "^18.0.10",
    "eslint": "8.29.0",
    "eslint-config-next": "13.0.6",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "clean-build": "rm -rf dist public/env.js",
    "clean": "rm -rf node_modules && npm run clean-build",
