    "watch": "PORT=3001 react-scripts start",
    "prebuild": "npm run clean-build",
    "build": "PUBLIC_URL=/playground BUILD_PATH=./dist react-scripts build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
