{
  "name": "@sharp-server/image-api",
  "version": "0.1.0",
  "author": "Jeremy Wallez <jeremy.wallez@gmail.com>",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf node_modules && npm run clean:build",
    "clean:build": "rm -rf dist",
    "start": "node dist/index.js",
    "watch": "nodemon --quiet --watch './**/*' | pino-pretty -l -S -i name,pid,hostname",
    "test": "NODE_ENV=test jest --ci",
    "test:watch": "npm test -- --watchAll",
    "copy:default-env": "cp -f src/config/.env.defaults dist/.env.defaults",
    "copy:public": "cp -rf public dist/public",
    "copy:playground": "cp -arf ../../node_modules/@sharp-server/image-api-playground/dist/. dist/public/playground",
    "copy:all": "mkdir -p dist && npm run copy:default-env && npm run copy:public && npm run copy:playground",
    "prebuild": "npm run clean:build",
    "build": "npx esbuild src/index.ts --bundle --minify --sourcemap --platform=node --external:sharp --target=es2020 --outfile=dist/index.js",
    "postbuild": "npm run copy:all",
    "lambda:install-external-sharp": "mkdir -p dist/node_modules && cd dist && SHARP_IGNORE_GLOBAL_LIBVIPS=1 npm install --arch=x64 --platform=linux --libc=glibc sharp",
    "lambda:zip": "cd dist && zip -r ./lambda.zip .env.defaults *",
    "prebuild:lambda": "npm run clean:build && npm run lambda:install-external-sharp && npm run copy:all",
    "build:lambda": "npx esbuild src/lambda.ts --bundle --minify --sourcemap --platform=node --external:sharp --target=es2020 --outfile=dist/index.js",
    "postbuild:lambda": "npm run lambda:zip"
  },
  "keywords": [],
  "license": "ISC",
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,ts,tsx",
    "ignore": [
      "test/**/*.spec.ts"
    ],
    "exec": "ts-node -r tsconfig-paths/register --files ./src/index.ts"
  },
  "devDependencies": {
    "@jest-mock/express": "^2.0.1",
    "@types/dotenv-defaults": "^2.0.1",
    "@types/dotenv-parse-variables": "^2.0.1",
    "@types/express": "^4.17.14",
    "@types/fs-extra": "^9.0.13",
    "@types/jest": "^29.2.3",
    "@types/node": "^18.11.9",
    "@types/serve-favicon": "^2.5.3",
    "@types/sharp": "^0.31.0",
    "@types/supertest": "^2.0.12",
    "esbuild": "^0.16.6",
    "jest": "^29.3.1",
    "nock": "^13.2.9",
    "nodemon": "^2.0.20",
    "pino-pretty": "^9.1.1",
    "rimraf": "^3.0.2",
    "stream-equal": "^2.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.0",
    "tsconfig-paths-jest": "^0.0.1",
    "ttypescript": "^1.5.15",
    "typescript": "^4.8.4",
    "typescript-transform-paths": "^3.4.4"
  },
  "dependencies": {
    "@sharp-server/image-api-playground": "^0.1.0",
    "@vendia/serverless-express": "^4.10.1",
    "ajv": "^8.11.2",
    "axios": "^1.1.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "crypto": "^1.0.1",
    "dotenv-defaults": "^5.0.2",
    "dotenv-expand": "^10.0.0",
    "dotenv-parse-variables": "^2.0.0",
    "express": "^4.18.2",
    "express-healthcheck": "^0.1.0",
    "fs-extra": "^10.1.0",
    "lz-string": "^1.4.4",
    "pino": "^8.7.0",
    "reflect-metadata": "^0.1.13",
    "sharp": "^0.31.3"
  }
}
